[Unit]
Description=ProperOS 2.5 Installer (live media)
After=multi-user.target network-online.target
Wants=network-online.target
# 只在 live 介质上运行，装完的系统里不会触发
ConditionPathExists=/media/cdrom/live/rootfs.squashfs
ConditionPathExists=!/var/lib/properos/installed

[Service]
Type=simple
# 切到空闲 VT 并解绑 fbcon，让安装器独占 framebuffer
ExecStartPre=-/bin/sh -c 'chvt 7 2>/dev/null || true'
ExecStart=/usr/local/sbin/properos-setup
# 图形安装器不可用（无 framebuffer）时回退到文本向导
ExecStartPost=-/bin/sh -c 'true'
Restart=no
StandardInput=null
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
