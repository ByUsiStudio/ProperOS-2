<event><eventItme type="onrefresh">us(7,"refreshing","false")
utw(null,"","确定刷新桌面吗？","确定","取消",true,v)
{
	endutw()
	fe("$System/code/homeLib.cuk",huk)
	f(huk == true)
	{
		fr("$System/code/homeLib.cuk",code)
		fn system.code(code,16)
	}
	else
	{
		fn core.uigo("setting.iyu")
		fn tw.tw2("请通过更新功能获取并安装最新的桌面刷新解析逻辑",1)
		end()
	}
}
else
{
	us(7,"refreshing","false")
	endutw()
}</eventItme></event>
