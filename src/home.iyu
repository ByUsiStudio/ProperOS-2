<UIEventset><eventItme type="loading">fn byusi.ztl()
fn byusi.uycl()
fn lib.wp(2)

//工具栏字体设置
gvs(11,toolbar)
java(titleView,toolbar,"android.view.ViewGroup.getChildAt","int",0)
us(titleView,"typeface","@fontFile/acbt80.ttf")
us(titleView,"app_TitleColor","#ffffffff")

//一言
fr("$System/Config/hitokoto.sett",hitokoto_zt)
f(hitokoto_zt != false)
{
	t()
	{
		hs("https://api.www.cdifit.cn/yy/?encode=json",url)
		json(url,data)
		json(data,"get","hitokoto",hitokoto)
		ufnsui()
		{
			utw(null,"",hitokoto,false,v)
			{
			}
		}
	}
}</eventItme><eventItme type="loadingComplete">//桌面刷新逻辑，后续会使用.cuk脚本来写
fe("$System/code/homeLib.cuk",huk)
f(huk == true)
{
	fr("$System/code/homeLib.cuk",code)
	fn system.code(code,16)
}
else
{
	fr("@System/homeLib.cuk",code)
	fn system.code(code,16)
}
//工具栏初始化
utb(11)
//启动自动执行区域
t()
{
	hs("https://code.properos.cn/start",url)
	f(url != null)
	{
		ufnsui()
		{
			fn system.code(url,12)
		}
	}
	else
	{
		syso("未链接网络")
	}
}
//</eventItme><eventItme type="menu">case 守护进程启动:

fn guardianService.run(500)

break

case 获取云端公告信息:

t()
{
	ufnsui()
	{
		fn lib.loading("获取云端公告中...")
	}
	hs("https://code.properos.cn/",cuk)
	endutw()
	ufnsui()
	{
		fn system.code(cuk,12)
	}
	syso(cuk)
}

break

case 重启软件:

fw("$System/Config/DaemonServiceOn.sett","false")
utw(null,"","确定重启吗？","重启","取消",true,v)
{
	call(null,"mjava","restart.st",activity)
}
else
{
	endutw()
}

break

case 关闭ProperOS:

utw(null,"","确定关闭 ProperOS 吗？","确定","取消",false,v)
{
	fw("$System/Config/DaemonServiceOn.sett","false")
	java {
			miao.youwan.to_be_riftinued.tools.Quit.exitApp(activity);
	}
}
else
{
	endutw()
}

break</eventItme><eventItme type="downkey">f(st_kC == 4)
{
	utw(null,"","请选择操作类型","关闭ProperOS Two","误触",true,v)
	{
		java {
			miao.youwan.to_be_riftinued.tools.Quit.exitApp(activity);
		}
	}
	else
	{
