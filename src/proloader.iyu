<UIEventset><eventItme type="loading">fn byusi.ztl()</eventItme><eventItme type="loadingComplete">f(sss.proloader == null)
{
	fr("@System/BootUp/proloader.sboot",proloader_code)
	fn system.code(proloader_code,5)
}
else f(sss.proloader == "edit")
{
	us(3,"visibility","visible")
	tws(v,"已启动 ProLoader 模式",0)
	{
	}
    //执行解析配置逻辑
    fr("$System/Config/ProLoader/config.json",config)
    json(config,config)
    json(config,"get","enable_supan",enable_supan)
    json(config,"get","enable_strict_perm",enable_strict_perm)
    json(config,"get","enable_install_dev",enable_install_dev)
    json(config,"get","enable_unlock_proldr",enable_unlock_proldr)
    json(config,"get","enable_console",enable_console)
    json(config,"get","enable_mod_stboot",enable_mod_stboot)
    //其余配置读取
    json(config,"get","boot",data_boot)
    json(data_boot,"get","sleep",sleep)
    json(data_boot,"get","icon",icon)
    json(data_boot,"get","background",background)
    json(data_boot,"get","stboot",stboot)
    json(data_boot,"get","ui",ui)
    //UI上传
    us(17,"text",enable_supan)
    us(22,"text",enable_strict_perm)
    us(27,"text",enable_install_dev)
    us(32,"text",enable_unlock_proldr)
    us(37,"text",enable_console)
    us(42,"text",enable_mod_stboot)
    us(47,"text",sleep)
    us(52,"text",icon)
    us(57,"text",background)
    us(62,"text",stboot)
    us(67,"text",ui)
}</eventItme><eventItme type="downkey">f(st_kC == 4)
{
}</eventItme></UIEventset>