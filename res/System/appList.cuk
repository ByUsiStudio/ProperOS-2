slower(sss.fileDir,houyi)
syso("检测到请求打开文件："+sss.fileDir)

f(houyi *? ".mp3" || houyi *? ".flac" || houyi *? ".ogg" || houyi *? ".m4a")
{
	ulag(st_vW,14,name)
	syso("类型为音频文件")
	s dir ="$System/MusicPlayer/index.html"
	fdir(sss.fileDir,sss.fileDir)
	fuz("@resources/sdk/MusicPlayer.zip","MusicPlayer/index.html","$System",true,b)
	fr(dir,mpd)
	sr(mpd,"[File]",sss.fileDir,mpd)
	sr(mpd,"[FileName]",name,mpd)
	fw(dir,mpd)
	sss url =dir
	fn core.uigo("startApp.iyu")
}
else
{
	se(sss.fileDir,"\\.([a-zA-Z0-9]+)$",0,shuc)
	se(shuc,"find",find)
	syso("FIND输出"+find)
	f(find == true)
	{
		se(shuc,"group",1,suffx)
	}
	else
	{
		s suffx ="error"
	}
	syso("文件后缀："+suffx)
	fe("@System/AppStart/open."+suffx+".cuk",yanz_wj)
	f(yanz_wj == true)
	{
		fr("@System/AppStart/open."+suffx+".cuk",code)
		fn system.code(code,20)
	}
}