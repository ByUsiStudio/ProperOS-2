//停止服务
// 停止服务器 - 可在另一个界面独立调用
java{
	// 注意：方法名改为 stopServer
	boolean result = miao.byusi.properos.two.app.startAppUI.stopServer();
	s.put("stop_result", result);
}

f(stop_result == true)
{
	tw("服务器已停止")
}
else
{
	tw("服务器未运行")
}



//查看状态
// 查看服务器状态
java{
	boolean running = miao.byusi.properos.two.app.startAppUI.isServerRunning();
	s.put("is_running", running);
	
	if (running) {
		int port = miao.byusi.properos.two.app.startAppUI.getServerPort();
		String rootPath = miao.byusi.properos.two.app.startAppUI.getServerRootPath();
		s.put("server_port", port);
		s.put("server_root", rootPath);
	}
}

