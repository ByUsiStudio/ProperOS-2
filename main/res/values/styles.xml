        <item name="colorSurfaceContainer">@color/m3_surface_container</item>
        <item name="colorSurfaceContainerLow">@color/m3_surface_container_low</item>
        <item name="colorSurfaceContainerHigh">@color/m3_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/m3_surface_container_highest</item>
        
        <item name="android:colorBackground">@color/m3_background</item>
        <item name="colorOnBackground">@color/m3_on_background</item>
        
        <item name="colorOutline">@color/m3_outline</item>
        <item name="colorOutlineVariant">@color/m3_outline_variant</item>
        
        <item name="android:statusBarColor">?attr/colorPrimary</item>
        <item name="android:navigationBarColor">?attr/colorPrimary</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <item name="fontFamily">sans-serif</item>
        
        <item name="android:windowBackground">?attr/colorSurface</item>
        
        <item name="materialThemeOverlay">@style/ThemeOverlay.Main</item>
    </style>
    
    <style name="Theme.Main.Dark" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/m3_primary_dark</item>
        <item name="colorOnPrimary">@color/m3_on_primary_dark</item>
        <item name="colorPrimaryContainer">@color/m3_primary_container_dark</item>
