#!/bin/bash
# ProperOS 2.5 Mobile · 首次启动初始化
set -e

echo "[properos] first boot setup"

# 标记当前槽启动成功，清零失败计数
/usr/sbin/properos-bootctl mark-good 2>/dev/null || true

# 应用与数据目录
mkdir -p /data/apps /data/.trash /data/home
chmod 0755 /data/apps
if ! getent group properapps >/dev/null; then
    groupadd -g 10000 properapps || true
fi
chown -R 10000:10000 /data/home 2>/dev/null || true

# SSH 主机密钥
if [ -x /usr/bin/ssh-keygen ]; then
    ssh-keygen -A >/dev/null 2>&1 || true
fi

# 容器运行时
if [ -x /usr/bin/podman ]; then
    install -d -m 0755 /var/lib/containers/storage
    systemctl enable --now podman.socket >/dev/null 2>&1 || true
fi

# 时区默认东八区
ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime 2>/dev/null || true

# 完成标记
rm -f /data/.first-boot
echo "[properos] first boot done"
